rules_version = '2';

// GroundLog Firebase Storage rules.
//
// Per-user file isolation: each owner reads/writes only their own {uid}/ prefix.
// Shared files (photos, KML, documents) reach other project members via the
// persisted download-URL token saved in Firestore — the token IS the capability,
// so no cross-user Storage read rule is needed (same trust model across all three).
//
// Brought into the repo 2026-06-20 (was console-only) so Storage rules are
// version-controlled like firestore.rules. Reconciled from the live console
// ruleset; only the docs/ block is new.
//
// 9/17 launch-readiness audit (S2): per-object size caps (photos 40 MB, kml 100 MB,
// docs 300 MB, planOverlays 100 MB; largest live objects 9/17: 11.6 / 40.6 / 119 / 4.9 MB). `delete` is split out because request.resource
// is null on a delete. Content-type rules are deliberately NOT here yet: several
// uploads call .put(blob) with no explicit type. A size cap bounds one object, not an
// account: the per-account quota + App Check are the 1.0.1 follow-up.
//
// Deploy: firebase deploy --only storage  — reconcile against the live console first.

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    match /photos/{uid}/{allPaths=**} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.size < 40 * 1024 * 1024;
    }
    match /kml/{uid}/{allPaths=**} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.size < 100 * 1024 * 1024;
    }
    match /docs/{uid}/{allPaths=**} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.size < 300 * 1024 * 1024;
    }
    match /planOverlays/{uid}/{allPaths=**} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.size < 100 * 1024 * 1024;
    }
  }
}
